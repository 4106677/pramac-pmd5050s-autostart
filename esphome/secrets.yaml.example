# Скопіюйте у secrets.yaml (він у .gitignore) і заповніть своїми значеннями.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
api_encryption_key: "generate-with: esphome (32 bytes base64)"
ota_password: "change-me"
ap_password: "change-me-8chars+"
gen_ap_password: "min-8-chars"   # generator.yaml: Wi-Fi точка плати для нового власника
gen_ota_password: "change-me"     # generator.yaml: пароль оновлення прошивки
